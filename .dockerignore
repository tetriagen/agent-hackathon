# Secrets and local state: never copy into the image
.env
.env.*
!.env.example
logs/
data/*.db

# Local environments and dependencies
.venv/
node_modules/
__pycache__/
*.pyc
.pytest_cache/

# Version control and local tooling
.git/
.gitignore
.playwright/
.playwright-cli/
.agents/
.pytest_cache/
artifacts/*
!artifacts/.gitkeep
